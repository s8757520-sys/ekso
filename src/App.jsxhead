import { useState } from "react";

function App() {
  const [nickname, setNickname] = useState("");
  const [status, setStatus] = useState("");
  const [isLoading, setIsLoading] = useState(false);

  const checkNickname = async () => {
    if (!nickname || nickname.length < 3) {
      setStatus("❌ Минимум 3 символа");
      return;
    }

    setIsLoading(true);
    setStatus("⏳ Проверка...");

    setTimeout(() => {
      if (nickname === "admin" || nickname === "test") {
        setStatus("❌ Никнейм уже занят");
      } else {
        setStatus("✅ Никнейм доступен!");
      }
      setIsLoading(false);
    }, 1000);
  };

  return (
    <div className="min-h-screen bg-gray-100 flex items-center justify-center p-4">
      <div className="bg-white rounded-2xl shadow-xl p-6 w-full max-w-md">
        <h1 className="text-3xl font-bold text-center text-gray-800 mb-2">
          Добро пожаловать в Ekso
        </h1>
        <p className="text-center text-gray-500 mb-6">
          Придумайте уникальный никнейм
        </p>

        <div className="space-y-4">
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-1">
              Никнейм
            </label>
            <div className="flex items-center border rounded-lg overflow-hidden focus-within:ring-2 focus-within:ring-blue-500">
              <span className="bg-gray-100 px-3 py-2 text-gray-500">@</span>
              <input
                type="text"
                value={nickname}
                onChange={(e) => setNickname(e.target.value)}
                placeholder="например, alex"
                className="flex-1 px-3 py-2 outline-none"
                maxLength={20}
              />
            </div>
            <p className="text-xs text-gray-400 mt-1">
              от 3 до 20 символов, только латиница и цифры
            </p>
          </div>

          {status && (
            <div className={"p-3 rounded-lg text-center " + (
              status.includes("✅") ? "bg-green-50 text-green-600" :
              status.includes("❌") ? "bg-red-50 text-red-600" :
              "bg-blue-50 text-blue-600"
            )}>
              {status}
            </div>
          )}

          <button
            onClick={checkNickname}
            disabled={isLoading || !nickname}
            className="w-full py-3 px-4 bg-blue-600 hover:bg-blue-700 disabled:bg-blue-300 text-white font-medium rounded-lg transition-colors"
          >
            {isLoading ? "Проверка..." : "Проверить никнейм"}
          </button>
        </div>

        <p className="text-xs text-center text-gray-400 mt-6">
          Нажимая "Проверить", вы соглашаетесь с условиями использования
        </p>
      </div>
    </div>
  );
}

export default App; -5 src/App.jsx
